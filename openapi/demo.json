{
  "openapi": "3.0.3",
  "info": {
    "title": "隔离的请求机制演示",
    "version": "1.0.0"
  },
  "paths": {
    "/demo/protected": {
      "get": {
        "operationId": "protectedRequest",
        "tags": ["Demo"],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "示例响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AjaxResultDemoMessage"
                }
              }
            }
          }
        }
      }
    },
    "/demo/metrics": {
      "get": {
        "operationId": "getMetrics",
        "tags": ["Demo"],
        "parameters": [
          {
            "name": "scenario",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "示例响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AjaxResultDemoMetrics"
                }
              }
            }
          }
        }
      }
    },
    "/demo/upload": {
      "post": {
        "operationId": "uploadFile",
        "tags": ["Demo"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "演示上传结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AjaxResultDemoUpload"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DemoMessage": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "DemoMetric": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "AjaxResultDemoMessage": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/DemoMessage"
          }
        }
      },
      "AjaxResultDemoMetrics": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DemoMetric"
            }
          }
        }
      },
      "DemoUpload": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "AjaxResultDemoUpload": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/DemoUpload"
          }
        }
      }
    }
  }
}
